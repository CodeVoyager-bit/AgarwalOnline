# Dependencies
node_modules/

# Next.js build output (.next-e2e is the Playwright build)
.next/
.next-e2e/
out/
# Regenerated by next dev / build / typegen; Next.js docs say not to commit it
next-env.d.ts
*.tsbuildinfo

# Environment files: real secrets never go to Git. Only the template is tracked.
.env
.env.*
!.env.example

# Local MongoDB data and uploaded evidence photos
.local/

# Test output
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Deployment tooling
.vercel/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Private keys and certificates
*.pem
*.key

# Personal Claude Code settings (shared launch.json stays tracked)
.claude/settings.local.json
